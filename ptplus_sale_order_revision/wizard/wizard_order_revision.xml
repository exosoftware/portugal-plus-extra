<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="wizard_order_revision_form" model="ir.ui.view">
        <field name="name">wizard.order.revision.form</field>
        <field name="model">wizard.order.revision</field>
        <field name="arch" type="xml">
            <form string="New Order">
                <field name="invoice_ids" invisible="1" />
                <div class="o_row">
                    <label for="invoices " invisible="not invoice_ids" string="Do you want to copy invoices?"/>
                    <field name="invoices" invisible="not invoice_ids" widget="boolean_toggle"/>
                </div>
                <div class="o_row">
                    <label for="chatter" string="Do you want to copy the chatter?"/>
                    <field name="chatter" widget="boolean_toggle"/>
                </div>

                <footer>
                    <button name="pt_create_revision" type="object" string="Create Order" class="btn-primary"/>
                    <button name="cancel" special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
